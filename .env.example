# Copy to .env for local overrides. .env and credentials are never served.
NODE_ENV=development
# Production defaults to 0.0.0.0; local development defaults to 127.0.0.1.
# HOST=127.0.0.1
PORT=4173
# Absolute path recommended; defaults to .cache next to server.mjs.
# CACHE_DIR=/var/lib/stocklens
RATE_LIMIT_PER_MINUTE=90
# Empty means direct connections only. Exact trusted peer IPs, never true or a hop count.
TRUST_PROXY=
SOURCE_CONCURRENCY=2
SOURCE_MAX_QUEUE=16
SOURCE_TIMEOUT_MS=10000
SOURCE_STALE_MS=86400000
SHUTDOWN_TIMEOUT_MS=10000
# Optional source credentials, server-side only. demo or pro.
COINGECKO_PLAN=demo
# COINGECKO_API_KEY=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BASE_RPC_URL=https://base-rpc.publicnode.com
# ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
